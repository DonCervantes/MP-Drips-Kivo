# ==============================================================================
# Variables Públicas (Cliente / Navegador - Prefijo VITE_*)
# Embebidas en el bundle público de Vite. NO colocar claves secretas aquí.
# ==============================================================================
VITE_SUPABASE_URL=               # URL pública del proyecto Supabase
VITE_SUPABASE_ANON_KEY=          # Anon key pública de Supabase
VITE_KIVO_PLATFORM_ADDRESS=      # Dirección pública Stellar de la plataforma Kivo (opcional)
VITE_BFF_URL=                    # URL base del BFF si está en otro host (opcional, default: relativo /api)

# ==============================================================================
# Variables Server-Only (BFF / Backend / Serverless)
# Viven exclusivamente en el servidor o funciones serverless.
# El navegador NUNCA las recibe ni tiene acceso a ellas.
# ==============================================================================

# Etherfuse FX API
ETHERFUSE_API_KEY=               # API Key privada de Etherfuse (secreto operativo)
ETHERFUSE_BASE_URL=              # URL base de Etherfuse (default: https://api.sand.etherfuse.com)
ETHERFUSE_CUSTOMER_ID=           # UUID de la organización Kivo en Etherfuse
ETHERFUSE_WALLET_ID=             # UUID de la wallet de plataforma Kivo en Etherfuse

# Trustless Work Escrow API
TRUSTLESS_API_KEY=               # API Key privada de Trustless Work para Testnet
TRUSTLESS_API_KEY_MAINNET=       # API Key privada de Trustless Work para Mainnet
TRUSTLESS_BASE_URL=              # URL base Trustless Testnet (default: https://dev.api.trustlesswork.com)
TRUSTLESS_MAINNET_BASE_URL=      # URL base Trustless Mainnet (default: https://api.trustlesswork.com)

# Servidor BFF independiente (opcional)
PORT=3001
